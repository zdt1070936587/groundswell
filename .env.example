# ---- 基础 ----
# 本机开发连 docker compose 暴露的端口；容器内由 compose 覆盖为 db:5432
# 本机 5432 已被占用时改 GS_DB_HOST_PORT，并同步改下面的连接串
GS_DB_HOST_PORT=5432
GS_DATABASE_URL=postgresql+psycopg://groundswell:groundswell@127.0.0.1:5432/groundswell
POSTGRES_PASSWORD=groundswell
GS_RSSHUB_URL=http://127.0.0.1:1200
# GS_HTTP_PROXY=http://127.0.0.1:7890

# ---- 数据源凭证（可选，缺失时对应源降级或跳过） ----
# RSSHub 微博路由需要登录 Cookie（浏览器登录 m.weibo.cn 后复制）
WEIBO_COOKIES=
# 公开 JSON 在多数网络下返回 403，Reddit 源需要 OAuth 凭证
# Reddit: https://www.reddit.com/prefs/apps 创建 script 类型应用
GS_REDDIT_CLIENT_ID=
GS_REDDIT_CLIENT_SECRET=
# GitHub token 提高 Search API 限额
GS_GITHUB_TOKEN=

# ---- 推送 ----
# 钉钉自定义机器人（安全设置选“加签”）
GS_DINGTALK_WEBHOOK=
GS_DINGTALK_SECRET=

# ---- Embedding ----
# hash: 本地哈希向量（无需密钥，仅同语种有效，开发用）
# api:  OpenAI 兼容接口，默认 SiliconFlow 的 BAAI/bge-m3
# local: sentence-transformers 本地加载 bge-m3（需安装 local-embed 可选依赖）
GS_EMBEDDING_PROVIDER=hash
GS_EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
GS_EMBEDDING_API_KEY=
GS_EMBEDDING_MODEL=BAAI/bge-m3

# ---- LLM（LiteLLM 模型名；留空则走启发式模式） ----
# 例：deepseek/deepseek-chat、openai/qwen-plus（配合 OPENAI_API_BASE）、anthropic/claude-...
GS_LLM_CHEAP_MODEL=
GS_LLM_STRONG_MODEL=
GS_LLM_DAILY_BUDGET_CNY=20
GS_LLM_DEEP_DAILY_CAP=50
# LiteLLM 按厂商读取各自的密钥环境变量
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ---- 服务 ----
# 设置后 API 需要 Authorization: Bearer <token>
GS_API_TOKEN=
GS_REPORT_TIMEZONE=Asia/Shanghai
GS_REPORT_HOUR=8
# 设置后定时任务与按源拆分的采集任务走 Redis 队列，由 gs worker 消费
# （docker compose --profile scale 会为 worker 自动注入；app 也要设置才会投递）
# GS_REDIS_URL=redis://redis:6379/0

# ---- Web 前端（docker compose --profile web）----
# 设置后整站需要 Basic Auth 登录；API token 只在服务端使用，不会下发到浏览器
GS_WEB_USER=
GS_WEB_PASSWORD=
